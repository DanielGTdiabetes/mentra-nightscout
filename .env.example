# Package/App info
PACKAGE_NAME=com.tucompania.nightscout-glucose
MENTRAOS_API_KEY=MENTRA_API_KEY
PORT=3000
NODE_ENV=development

# Nightscout Real Configuration - USING TOKEN
DEFAULT_NIGHTSCOUT_URL=https://your-nightscout.herokuapp.com
DEFAULT_TOKEN=XXXXXXXX

# App display options
ENABLE_ADVANCED_MODE=false   # true = show TIR, CH/Ins, Min/Max; false = only glucose+trend+time
DISPLAY_LANGUAGE=EN          # EN or ES

# TIR / Glucose thresholds
LOW_ALERT_MG=70
HIGH_ALERT_MG=180

# Render keep-alive (optional)
KEEP_ALIVE_URL=https://your-app.onrender.com
